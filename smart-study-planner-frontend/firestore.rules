rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // True if the signed-in user is an active admin (any org).
    // Used for operations where the requester's own org context is what matters.
    function isActiveAdmin() {
      return signedIn()
        && userDocExists()
        && getUserDoc().data.membershipStatus == "active"
        && getUserDoc().data.role == "admin";
    }

    // True if the signed-in user is an active member of the given org.
    function isActiveMember(orgId) {
      return signedIn()
        && userDocExists()
        && getUserDoc().data.organizationId == orgId
        && getUserDoc().data.membershipStatus == "active"
        && getUserDoc().data.role in ["admin", "teacher", "student"];
    }

    // True if the signed-in user is an active admin of the given org.
    function isActivatedAdmin(orgId) {
      return isActiveMember(orgId)
        && getUserDoc().data.role == "admin";
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // users/{uid} is the single source of truth for membership.
    //
    // Fields controlled by the system / admin only:
    //   organizationId, role, departmentId, membershipStatus (to "pending")
    //
    // Fields the user can change themselves:
    //   membershipStatus: "pending" → "active" (accept)
    //   displayName, email, updatedAt (profile refresh)
    match /users/{userId} {

      // A user can always read their own document.
      // An active admin can read any user document (needed for email lookup when inviting).
      allow read: if isSelf(userId) || isActiveAdmin();

      // A user can create their own document with membershipStatus: "not_invited".
      allow create: if isSelf(userId)
        && request.resource.data.membershipStatus == "not_invited"
        && request.resource.data.organizationId == null
        && request.resource.data.role == null;

      // Self-update: user can only change profile fields (displayName, email, updatedAt)
      // OR accept a pending membership (flip membershipStatus from "pending" to "active").
      // In both cases, organizationId / role / departmentId must not change.
      allow update: if isSelf(userId)
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.role == resource.data.role
        && request.resource.data.departmentId == resource.data.departmentId
        && (
          // Accept: membershipStatus pending → active only
          (
            resource.data.membershipStatus == "pending"
            && request.resource.data.membershipStatus == "active"
          )
          ||
          // Profile refresh / migration: membershipStatus stays the same
          // (also covers first-time migration write of inferred membershipStatus)
          (
            request.resource.data.membershipStatus == resource.data.membershipStatus
            || (!("membershipStatus" in resource.data) && request.resource.data.membershipStatus in ["active", "not_invited"])
          )
        );

      // Admin invite: an active admin can update another user's document to invite them.
      // The admin can only set:
      //   organizationId = their own org
      //   role = "teacher" or "student" (admins cannot be invited, they create orgs)
      //   membershipStatus = "pending"
      //   departmentId, organizationName, departmentName (optional metadata)
      // The admin cannot change the invitee's email, displayName, or createdAt.
      allow update: if signedIn()
        && !isSelf(userId)
        && isActiveAdmin()
        && request.resource.data.organizationId == getUserDoc().data.organizationId
        && request.resource.data.membershipStatus == "pending"
        && request.resource.data.role in ["teacher", "student"]
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    // ── Organizations ─────────────────────────────────────────────────────────
    match /organizations/{organizationId} {

      allow read: if isActiveMember(organizationId);

      allow create: if signedIn()
        && request.resource.data.id == organizationId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email;

      allow update: if isActivatedAdmin(organizationId);

      allow delete: if isActivatedAdmin(organizationId)
        && getUserDoc().data.uid == resource.data.createdBy;
    }

    // ── Departments ───────────────────────────────────────────────────────────
    // Read:   any active member of the organization (admin, teacher, student).
    // Write:  only active admins of the organization.
    // Outside users cannot read or write.
    match /organizations/{organizationId}/departments/{departmentId} {

      allow read: if isActiveMember(organizationId);

      allow create: if isActivatedAdmin(organizationId)
        && request.resource.data.id == departmentId
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isActivatedAdmin(organizationId);

      allow delete: if isActivatedAdmin(organizationId);
    }

    // ── Tasks ─────────────────────────────────────────────────────────────────
    match /tasks/{taskId} {

      allow read: if signedIn()
        && (
          request.auth.uid == resource.data.userId
          || request.auth.uid == resource.data.assignedTo
          || isActiveMember(resource.data.organizationId)
        );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ── Categories ────────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if signedIn()
        && request.auth.uid == resource.data.userId;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

  }
}
