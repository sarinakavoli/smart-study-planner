rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveAdmin() {
      return signedIn()
        && userDocExists()
        && getUserDoc().data.membershipStatus == "active"
        && getUserDoc().data.role == "admin";
    }

    function isActiveMember(orgId) {
      return signedIn()
        && userDocExists()
        && getUserDoc().data.organizationId == orgId
        && getUserDoc().data.membershipStatus == "active"
        && getUserDoc().data.role in ["admin", "teacher", "student"];
    }

    function isActivatedAdmin(orgId) {
      return isActiveMember(orgId)
        && getUserDoc().data.role == "admin";
    }

    // ── Users ──────────────────────────────────────────────────────────────────
    match /users/{userId} {

      allow read: if isSelf(userId) || isActiveAdmin();

      allow create: if isSelf(userId)
        && request.resource.data.membershipStatus == "not_invited"
        && request.resource.data.organizationId == null
        && request.resource.data.role == null;

      // Profile refresh: no structural fields change (org, role, dept, status, email, createdAt).
      allow update: if isSelf(userId)
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.role == resource.data.role
        && request.resource.data.departmentId == resource.data.departmentId
        && request.resource.data.membershipStatus == resource.data.membershipStatus
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;

      // Accept invitation OR create org: user transitions to active status.
      // Covers both invitation acceptance (teacher/student) and org creation (admin).
      allow update: if isSelf(userId)
        && resource.data.membershipStatus != "active"
        && request.resource.data.membershipStatus == "active"
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.role in ["admin", "teacher", "student"];

      allow delete: if false;
    }

    // ── Invitations ────────────────────────────────────────────────────────────
    // invitations/{invitationId}
    //
    // Fields written by admin:
    //   email, role, organizationId, organizationName,
    //   departmentId (optional), departmentName (optional),
    //   status: "pending", createdBy, createdByEmail, createdAt, updatedAt
    //
    // Fields written by invited user on accept:
    //   status: "accepted", acceptedAt, updatedAt
    match /invitations/{invitationId} {

      // Active admin can create invitations only for their own organization.
      allow create: if isActiveAdmin()
        && request.resource.data.organizationId == getUserDoc().data.organizationId
        && request.resource.data.status == "pending"
        && request.resource.data.role in ["teacher", "student"]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email;

      // Invited user can read their own invitations (matched by email).
      // Active admin can read invitations for their own org.
      allow read: if (signedIn() && resource.data.email == request.auth.token.email)
        || (isActiveAdmin() && resource.data.organizationId == getUserDoc().data.organizationId);

      // Invited user can accept their own pending invitation (status: pending -> accepted).
      // No other fields may change.
      allow update: if signedIn()
        && resource.data.email == request.auth.token.email
        && resource.data.status == "pending"
        && request.resource.data.status == "accepted"
        && request.resource.data.email == resource.data.email
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // ── Organizations ──────────────────────────────────────────────────────────
    match /organizations/{organizationId} {

      allow read: if isActiveMember(organizationId);

      allow create: if signedIn()
        && request.resource.data.id == organizationId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email;

      allow update: if isActivatedAdmin(organizationId);

      allow delete: if isActivatedAdmin(organizationId)
        && getUserDoc().data.uid == resource.data.createdBy;
    }

    // ── Departments ────────────────────────────────────────────────────────────
    match /organizations/{organizationId}/departments/{departmentId} {

      allow read: if isActiveMember(organizationId);

      allow create: if isActivatedAdmin(organizationId)
        && request.resource.data.id == departmentId
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isActivatedAdmin(organizationId);

      allow delete: if isActivatedAdmin(organizationId);
    }

    // ── Tasks ──────────────────────────────────────────────────────────────────
    match /tasks/{taskId} {

      allow read: if signedIn()
        && (
          request.auth.uid == resource.data.userId
          || request.auth.uid == resource.data.assignedTo
          || isActiveMember(resource.data.organizationId)
        );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ── Categories ─────────────────────────────────────────────────────────────
    match /categories/{categoryId} {

      allow read: if signedIn()
        && request.auth.uid == resource.data.userId;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

  }
}
