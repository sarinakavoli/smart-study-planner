rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // True if the signed-in user's active organizationId (from users/{uid}) matches orgId.
    function hasActiveOrg(orgId) {
      return signedIn()
        && userDocExists()
        && getUserDoc().data.organizationId == orgId;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Membership and role data lives in users/{uid}.organizations array.
    // No memberships, invitations, or userIndex collections are used.
    match /users/{userId} {
      allow read: if isSelf(userId);

      allow create: if isSelf(userId)
        && request.resource.data.uid == request.auth.uid;

      allow update: if isSelf(userId)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      allow delete: if false;
    }

    // ── Organizations ─────────────────────────────────────────────────────────
    match /organizations/{organizationId} {

      // Any signed-in user whose active org matches may read.
      allow read: if signedIn() && hasActiveOrg(organizationId);

      // A signed-in user may create an org they own.
      // The document must include:
      //   id == the document ID
      //   createdBy == the requesting user's UID
      //   createdByEmail == the requesting user's email
      allow create: if signedIn()
        && request.resource.data.id == organizationId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email;

      // Active members may update their org document.
      allow update: if signedIn() && hasActiveOrg(organizationId);

      // Only the org creator may delete.
      allow delete: if signedIn()
        && hasActiveOrg(organizationId)
        && getUserDoc().data.uid == resource.data.createdBy;
    }

    // ── Tasks ─────────────────────────────────────────────────────────────────
    match /tasks/{taskId} {

      allow read: if signedIn()
        && (
          request.auth.uid == resource.data.userId
          || request.auth.uid == resource.data.assignedTo
          || hasActiveOrg(resource.data.organizationId)
        );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ── Categories ────────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if signedIn()
        && request.auth.uid == resource.data.userId;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

  }
}
