rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // True if the signed-in user's active organizationId (from users/{uid}) matches orgId.
    function hasActiveOrg(orgId) {
      return signedIn()
        && userDocExists()
        && getUserDoc().data.organizationId == orgId;
    }

    // True if the signed-in user is an activated admin of orgId.
    // Relies on users/{uid}.role — a flat field always kept in sync with the active org entry.
    function isActivatedAdmin(orgId) {
      return hasActiveOrg(orgId)
        && getUserDoc().data.role == "admin";
    }

    // True if the signed-in user is an activated member of orgId (any role).
    // Role must be one of admin / teacher / student and active org must match.
    function isActivatedMember(orgId) {
      return hasActiveOrg(orgId)
        && getUserDoc().data.role in ["admin", "teacher", "student"];
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Membership and role data lives in users/{uid}.organizations array.
    // No memberships, invitations, or userIndex collections are used for roles.
    match /users/{userId} {
      allow read: if isSelf(userId);

      allow create: if isSelf(userId)
        && request.resource.data.uid == request.auth.uid;

      allow update: if isSelf(userId)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      allow delete: if false;
    }

    // ── Organizations ─────────────────────────────────────────────────────────
    match /organizations/{organizationId} {

      // Any signed-in user whose active org matches may read.
      allow read: if signedIn() && hasActiveOrg(organizationId);

      // A signed-in user may create an org document they own.
      // The document must include:
      //   id == the document ID
      //   createdBy == the requesting user's UID
      //   createdByEmail == the requesting user's email
      allow create: if signedIn()
        && request.resource.data.id == organizationId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email;

      // Active members may update their org document.
      allow update: if signedIn() && hasActiveOrg(organizationId);

      // Only the org creator may delete.
      allow delete: if signedIn()
        && hasActiveOrg(organizationId)
        && getUserDoc().data.uid == resource.data.createdBy;
    }

    // ── Departments ───────────────────────────────────────────────────────────
    // Read:   any activated member of the organization (admin, teacher, student).
    // Write:  only activated admins of the organization.
    // Outside users cannot read or write.
    match /organizations/{organizationId}/departments/{departmentId} {

      allow read: if isActivatedMember(organizationId);

      allow create: if isActivatedAdmin(organizationId)
        && request.resource.data.id == departmentId
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isActivatedAdmin(organizationId);

      allow delete: if isActivatedAdmin(organizationId);
    }

    // ── Invitations ────────────────────────────────────────────────────────────
    match /invitations/{invitationId} {

      // The invitee can read their own invitations; the inviter can read what they sent.
      allow read: if signedIn()
        && (
          request.auth.token.email == resource.data.invitedEmail
          || request.auth.uid == resource.data.invitedByUserId
        );

      // A signed-in user with an active org in the target organization may create invitations.
      allow create: if signedIn()
        && request.resource.data.invitedByUserId == request.auth.uid
        && request.resource.data.invitedByEmail == request.auth.token.email
        && hasActiveOrg(request.resource.data.organizationId);

      // Only the invitee may update an invitation (to accept or decline).
      allow update: if signedIn()
        && request.auth.token.email == resource.data.invitedEmail
        && (
          request.resource.data.status == "accepted"
          || request.resource.data.status == "declined"
        );

      allow delete: if false;
    }

    // ── Tasks ─────────────────────────────────────────────────────────────────
    match /tasks/{taskId} {

      allow read: if signedIn()
        && (
          request.auth.uid == resource.data.userId
          || request.auth.uid == resource.data.assignedTo
          || hasActiveOrg(resource.data.organizationId)
        );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ── Categories ────────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if signedIn()
        && request.auth.uid == resource.data.userId;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

  }
}
