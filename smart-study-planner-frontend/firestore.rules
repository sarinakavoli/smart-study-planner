rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Recognises active admins.
    // Handles both:
    //   - New schema: membershipStatus == "active" && role == "admin"
    //   - Old/migration schema: no membershipStatus field yet, but organizationId + role == "admin" are set
    function isActiveAdmin() {
      return signedIn()
        && userDocExists()
        && getUserDoc().data.role == "admin"
        && getUserDoc().data.organizationId != null
        && (
          getUserDoc().data.membershipStatus == "active"
          || !("membershipStatus" in getUserDoc().data)
        );
    }

    // Recognises active members of a given org.
    // Same dual-schema handling as isActiveAdmin().
    function isActiveMember(orgId) {
      return signedIn()
        && userDocExists()
        && getUserDoc().data.organizationId == orgId
        && getUserDoc().data.role in ["admin", "teacher", "student"]
        && (
          getUserDoc().data.membershipStatus == "active"
          || !("membershipStatus" in getUserDoc().data)
        );
    }

    function isActivatedAdmin(orgId) {
      return isActiveMember(orgId)
        && getUserDoc().data.role == "admin";
    }

    // ── Users ──────────────────────────────────────────────────────────────────
    match /users/{userId} {

      allow read: if isSelf(userId) || isActiveAdmin();

      // Brand-new user doc created on first sign-in.
      allow create: if isSelf(userId)
        && request.resource.data.membershipStatus == "not_invited"
        && request.resource.data.organizationId == null
        && request.resource.data.role == null;

      // Profile refresh (display name, email, updatedAt only).
      // Structural fields (organizationId, role, departmentId) must not change.
      // membershipStatus must not change (separate rules below handle those transitions).
      allow update: if isSelf(userId)
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.role == resource.data.role
        && request.resource.data.departmentId == resource.data.departmentId
        && request.resource.data.membershipStatus == resource.data.membershipStatus
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;

      // Migration: write flat membershipStatus / role for users created under the old
      // schema (organizations array, no membershipStatus field).
      // Allowed only when membershipStatus has never been set on the doc.
      // organizationId and email must not change.
      allow update: if isSelf(userId)
        && !("membershipStatus" in resource.data)
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.email == resource.data.email;

      // Accept invitation OR create org:
      // User transitions from non-active to active (sets org fields from invitation).
      allow update: if isSelf(userId)
        && resource.data.membershipStatus != "active"
        && request.resource.data.membershipStatus == "active"
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.role in ["admin", "teacher", "student"];

      allow delete: if false;
    }

    // ── Invitations ────────────────────────────────────────────────────────────
    match /invitations/{invitationId} {

      // Active admin creates an invitation for their own org only.
      allow create: if isActiveAdmin()
        && request.resource.data.organizationId == getUserDoc().data.organizationId
        && request.resource.data.status == "pending"
        && request.resource.data.role in ["teacher", "student"]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email;

      // Invited user reads their own invitations (by email).
      // Active admin reads invitations for their own org.
      allow read: if (signedIn() && resource.data.email == request.auth.token.email)
        || (isActiveAdmin() && resource.data.organizationId == getUserDoc().data.organizationId);

      // Invited user accepts their own pending invitation (status: pending -> accepted).
      // No other fields may change.
      allow update: if signedIn()
        && resource.data.email == request.auth.token.email
        && resource.data.status == "pending"
        && request.resource.data.status == "accepted"
        && request.resource.data.email == resource.data.email
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // ── Organizations ──────────────────────────────────────────────────────────
    match /organizations/{organizationId} {

      allow read: if isActiveMember(organizationId);

      allow create: if signedIn()
        && request.resource.data.id == organizationId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email;

      allow update: if isActivatedAdmin(organizationId);

      allow delete: if isActivatedAdmin(organizationId)
        && getUserDoc().data.uid == resource.data.createdBy;
    }

    // ── Departments ────────────────────────────────────────────────────────────
    match /organizations/{organizationId}/departments/{departmentId} {

      allow read: if isActiveMember(organizationId);

      allow create: if isActivatedAdmin(organizationId)
        && request.resource.data.id == departmentId
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isActivatedAdmin(organizationId);

      allow delete: if isActivatedAdmin(organizationId);
    }

    // ── Tasks ──────────────────────────────────────────────────────────────────
    match /tasks/{taskId} {

      allow read: if signedIn()
        && (
          request.auth.uid == resource.data.userId
          || request.auth.uid == resource.data.assignedTo
          || isActiveMember(resource.data.organizationId)
        );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ── Categories ─────────────────────────────────────────────────────────────
    match /categories/{categoryId} {

      allow read: if signedIn()
        && request.auth.uid == resource.data.userId;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

  }
}
