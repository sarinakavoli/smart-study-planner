rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Active admin: role == "admin" and either membershipStatus == "active" OR
    // the old schema (no membershipStatus field yet but organizationId is set).
    function isActiveAdmin() {
      return signedIn()
        && userDocExists()
        && getUserDoc().data.role == "admin"
        && getUserDoc().data.organizationId != null
        && (
          getUserDoc().data.membershipStatus == "active"
          || !("membershipStatus" in getUserDoc().data)
        );
    }

    // Active member of a given org (same dual-schema handling as isActiveAdmin).
    function isActiveMember(orgId) {
      return signedIn()
        && userDocExists()
        && getUserDoc().data.organizationId == orgId
        && getUserDoc().data.role in ["admin", "teacher", "student"]
        && (
          getUserDoc().data.membershipStatus == "active"
          || !("membershipStatus" in getUserDoc().data)
        );
    }

    function isActivatedAdmin(orgId) {
      return isActiveMember(orgId)
        && getUserDoc().data.role == "admin";
    }

    // ── Users ──────────────────────────────────────────────────────────────────
    match /users/{userId} {

      // Users read their own doc. Active admins can read any user doc (for invite lookup).
      allow read: if isSelf(userId) || isActiveAdmin();

      // Brand-new user doc created on first sign-in.
      allow create: if isSelf(userId)
        && request.resource.data.membershipStatus == "not_invited"
        && request.resource.data.organizationId == null
        && request.resource.data.role == null;

      // Profile refresh: display name, email, updatedAt only.
      // Structural fields must not change.
      // Email may be updated, but only to the value the Firebase Auth token carries —
      // so users can keep their doc in sync when they change their Auth email,
      // but cannot set it to someone else's address.
      allow update: if isSelf(userId)
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.role == resource.data.role
        && request.resource.data.departmentId == resource.data.departmentId
        && request.resource.data.membershipStatus == resource.data.membershipStatus
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == resource.data.createdAt;

      // Migration: write flat membershipStatus / role for users created under the
      // old schema (organizations array, no membershipStatus field on the doc yet).
      allow update: if isSelf(userId)
        && !("membershipStatus" in resource.data)
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.email == resource.data.email;

      // Admin invites a user: writes pending invite fields to target user's doc.
      // Target must not already be active. Role must be teacher or student.
      // Also handles old-schema target docs that have no membershipStatus field.
      allow update: if isActiveAdmin()
        && !isSelf(userId)
        && (
          resource.data.membershipStatus in ["not_invited", "pending"]
          || !("membershipStatus" in resource.data)
        )
        && request.resource.data.membershipStatus == "pending"
        && request.resource.data.organizationId == getUserDoc().data.organizationId
        && request.resource.data.role in ["teacher", "student"]
        && request.resource.data.email == resource.data.email;

      // Invited user accepts: flips own doc from "pending" → "active".
      // Org fields do not change (they were already written by the admin).
      allow update: if isSelf(userId)
        && resource.data.membershipStatus == "pending"
        && request.resource.data.membershipStatus == "active"
        && request.resource.data.email == resource.data.email
        && request.resource.data.organizationId == resource.data.organizationId;

      // Create org: user creates their own org, transitions from "not_invited" → "active".
      // Email and createdAt must not change; role must be valid.
      allow update: if isSelf(userId)
        && resource.data.membershipStatus == "not_invited"
        && request.resource.data.membershipStatus == "active"
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.role in ["admin", "teacher", "student"];

      allow delete: if false;
    }

    // ── Organizations ──────────────────────────────────────────────────────────
    match /organizations/{organizationId} {

      allow read: if isActiveMember(organizationId);

      allow create: if signedIn()
        && request.resource.data.id == organizationId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email;

      allow update: if isActivatedAdmin(organizationId);

      allow delete: if isActivatedAdmin(organizationId)
        && getUserDoc().data.uid == resource.data.createdBy;
    }

    // ── Departments ────────────────────────────────────────────────────────────
    match /organizations/{organizationId}/departments/{departmentId} {

      allow read: if isActiveMember(organizationId);

      allow create: if isActivatedAdmin(organizationId)
        && request.resource.data.id == departmentId
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isActivatedAdmin(organizationId);

      allow delete: if isActivatedAdmin(organizationId);
    }

    // ── Tasks ──────────────────────────────────────────────────────────────────
    match /tasks/{taskId} {

      allow read: if signedIn()
        && (
          request.auth.uid == resource.data.userId
          || request.auth.uid == resource.data.assignedTo
          || isActiveMember(resource.data.organizationId)
        );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ── Categories ─────────────────────────────────────────────────────────────
    match /categories/{categoryId} {

      allow read: if signedIn()
        && request.auth.uid == resource.data.userId;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

  }
}
